---
import Head from "./head.pico";
import Cms from "../core/cms.pico";
prop env;
prop content;
prop user;
---

<!DOCTYPE html>
<html lang="en">
  <Head {env} {content} />
  <body>
    {if user.loggedIn}
      <Cms />
    {/if}
    <main>
      <='../content/{content.type}.pico' {content} />
      {if !user.loggedIn}
        <button onclick="{user.login()}">Login</button>
      {/if}
    </main>
  </body>
</html>
