---
prop env;
prop content;
prop user;
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{content.fields.title}</title>
  <link rel="stylesheet" href="/global.css" />
  {if user.loggedIn}
    <script src="/core/cms/cms.js"></script>
    <link rel="stylesheet" href="/core/cms/cms.css" />
  {/if}
</head>
